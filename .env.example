# Copy to .env at the repo root. Bun loads it via --env-file; Vite reads PORT,
# API_ORIGIN and BUILD from it, so the client finds the server.

# Server
PORT=3001
# A local file in development; Turso's libsql://... URL in production.
# `file:` paths are relative to THIS directory (the repo root), whatever the
# cwd of the process that opens them.
DATABASE_URL=file:./packages/server/wargame.db
# DATABASE_AUTH_TOKEN — Turso's token for that URL; a Fly secret in production.
# Unset for a local file. Keep the hosted pair under other names here (say
# TURSO_DATABASE_URL), or local development writes to the real database.

# Client
# The server's address, compiled into the client, which always reaches it
# cross-origin. Unset, it is the local server on PORT; a release sets it.
# API_ORIGIN=http://localhost:3001
# BUILD — a release's build number, set by CI for the client and the server.
# Unset, both are 0, and no client is ever out of date.
# GUEST_KEY — the key guest tokens are signed with. A Fly secret in production,
# where the server will not start without it; a fixed key is used elsewhere.
