{
  "name": "wargame",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run db:migrate && bun run --filter '@wargame/client' --filter '@wargame/server' dev",
    "gate": "sh scripts/gate.sh",
    "typecheck": "tsc -b",
    "build": "tsc -b && bun run --filter '@wargame/client' bundle",
    "lint": "eslint .",
    "test": "bun test packages/shared packages/server && bun run --filter '@wargame/client' test",
    "db:generate": "drizzle-kit generate --config packages/server/drizzle.config.ts && drizzle-kit export --config packages/server/drizzle.config.ts > packages/server/schema.sql",
    "db:migrate": "bun --env-file=.env packages/server/src/migrate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "bun run --filter '@wargame/client' preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "drizzle-kit": "0.31.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0"
  }
}
